{
  "functions": {
    "api/ships.js": {
      "maxDuration": 25
    },
    "api/trip.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/point/:lat/:lon/:nm",
      "destination": "/api/point?lat=:lat&lon=:lon&nm=:nm"
    },
    {
      "source": "/ships/:lat/:lon/:nm",
      "destination": "/api/ships?lat=:lat&lon=:lon&nm=:nm"
    },
    {
      "source": "/find/:q",
      "destination": "/api/find?q=:q"
    },
    {
      "source": "/route/:cs",
      "destination": "/api/route?cs=:cs"
    },
    {
      "source": "/trip/:f/:from/:to",
      "destination": "/api/trip?f=:f&from=:from&to=:to"
    }
  ]
}
